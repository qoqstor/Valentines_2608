rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 信件：允許任何人讀取，但完全禁止任何形式的寫入
    match /letters/{id} {
      allow read: if true;
      allow write: if false; 
    }
    
    // 猜測、中介資料、用戶：允許讀取（前端還需顯示），但完全禁止寫入
    match /guesses/{id} {
      allow read: if true;
      allow write: if false;
    }
    
    match /meta/{id} {
      allow read: if true;
      allow write: if false;
    }
    
    match /users/{uid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
